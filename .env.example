# ═══════════════════════════════════════════════════════════════
# Open-XP — Environment Variables Template
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.

# ─── Solana ──────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_PROGRAM_ID=oxpEXAM1111111111111111111111111111111111111
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# ─── AWS Cognito ─────────────────────────────────────────────
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=us-east-1

# ─── AWS API Gateway ────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/dev

# ─── AWS Backend (Lambda env vars — set in template.yaml) ───
# EXAM_TABLE_NAME=OpenXpExamTable-dev
# EXAM_BUCKET_NAME=open-xp-exams-dev-ACCOUNT_ID
# KMS_KEY_ID=arn:aws:kms:us-east-1:ACCOUNT_ID:key/KEY_ID
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_PROGRAM_ID=oxpEXAM1111111111111111111111111111111111111
